{
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|compact", "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/pandaward", "args": ["hook", "session-start"], "timeout": 15 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit", "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/pandaward", "args": ["hook", "pre-tool"], "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit", "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/pandaward", "args": ["hook", "post-edit"], "timeout": 10 } ] }
    ],
    "PreCompact": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/pandaward", "args": ["hook", "pre-compact"], "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/pandaward", "args": ["hook", "stop"], "timeout": 60 } ] }
    ]
  }
}
